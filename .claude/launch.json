{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev", "-p", "3123"],
      "port": 3123
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "mobile", "exec", "env", "EXPO_PUBLIC_API_URL=http://localhost:3123", "expo", "start", "--web", "--port", "8081"],
      "port": 8081
    }
  ]
}
