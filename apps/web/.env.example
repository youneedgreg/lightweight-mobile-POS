# Neon — pooled for the app, direct for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob (bottle images) — added automatically when the Blob store is connected
BLOB_READ_WRITE_TOKEN=

# First admin, used by `pnpm db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Production direct URL, only used by `pnpm db:migrate:prod`
PROD_DATABASE_URL_UNPOOLED=

# Auth.js session encryption and mobile token signing (generate with `openssl rand -base64 32`)
AUTH_SECRET=
MOBILE_JWT_SECRET=

# Optional test cashier created by `pnpm db:seed` (use only on the dev branch)
SEED_CASHIER_NAME=
SEED_CASHIER_PHONE=
SEED_CASHIER_PIN=
